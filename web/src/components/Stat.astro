---
// A plain numeric readout. Used for any figure that has no honest denominator:
// a gauge arc would imply a scale the number does not actually sit on.
interface Props {
  label: string;
  display: string;
  tone?: "cost" | "ink" | "critical";
  note?: string;
}
const { label, display, tone = "ink", note } = Astro.props;
---

<div class="stat" data-tone={tone}>
  <p class="eyebrow">{label}</p>
  <p class="v num">{display}</p>
  {note && <p class="note">{note}</p>}
</div>

<style>
  .stat {
    padding: 18px;
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .v {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: clamp(22px, 2.8vw, 29px);
    font-weight: 700;
    letter-spacing: -0.022em;
    line-height: 1.08;
    color: var(--tone-color);
  }

  .note {
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--ink3);
  }

  [data-tone="cost"] {
    --tone-color: var(--cost);
  }
  [data-tone="ink"] {
    --tone-color: var(--ink1);
  }
  [data-tone="critical"] {
    --tone-color: var(--critical);
  }
</style>
